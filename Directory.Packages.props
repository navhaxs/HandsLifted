<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AsyncImageLoader.Avalonia" Version="3.8.0" />
    <PackageVersion Include="AutofacSerilogIntegration" Version="5.0.0" />
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <!-- Lag behind core Avalonia releases on NuGet; pinned to their own latest published version. -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.0.1" />
    <PackageVersion Include="Avalonia.Browser" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    <!-- Avalonia.Controls.PanAndZoom renamed to PanAndZoom for Avalonia 12. -->
    <PackageVersion Include="PanAndZoom" Version="12.0.0.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <!-- No 12.x release yet; official successor is AvaloniaUI.DiagnosticsSupport but its
         API differs from AttachDevTools() and needs a real code port. Pinned to last 11.x
         build for now so restore succeeds - AttachDevTools() call sites need re-checking. -->
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.18" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" />
    <!-- Avalonia.ReactiveUI renamed to ReactiveUI.Avalonia (reactiveui org) for Avalonia 12. -->
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.0.3" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Svg.Skia" Version="11.3.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="$(AvaloniaVersion)" />
    <!-- Avalonia.Xaml.Behaviors/Interactions/Interactivity renamed to Xaml.Behaviors.* for Avalonia 12. -->
    <PackageVersion Include="Xaml.Behaviors.Avalonia" Version="12.0.5" />
    <PackageVersion Include="Xaml.Behaviors.Interactions" Version="12.0.5" />
    <PackageVersion Include="Xaml.Behaviors.Interactivity" Version="12.0.5" />
    <PackageVersion Include="BmpSharp" Version="0.2.0" />
    <PackageVersion Include="ByteSize" Version="2.1.1" />
    <PackageVersion Include="CefGlue.Avalonia" Version="120.6099.207" />
    <PackageVersion Include="ColorHelper" Version="1.8.1" />
    <PackageVersion Include="ConcurrentPriorityQueue" Version="2.1.0" />
    <PackageVersion Include="Config.Net" Version="5.2.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="DebounceThrottle" Version="2.0.0" />
    <PackageVersion Include="DynamicData" Version="9.4.31" />
    <PackageVersion Include="DynamicData.ReactiveUI" Version="6.11.0.2613" />
    <PackageVersion Include="EmbedIO" Version="3.5.2" />
    <PackageVersion Include="Google.Apis.Drive.v3" Version="1.63.0.3155" />
    <PackageVersion Include="Google.Apis.Slides.v1" Version="1.63.0.3107" />
    <PackageVersion Include="GridExtra.Avalonia" Version="0.9.1" />
    <PackageVersion Include="HanumanInstitute.LibMpv.Avalonia" Version="0.9.1" />
    <PackageVersion Include="HidApi.Net" Version="1.1.0" />
    <PackageVersion Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageVersion Include="LibUsbDotNet" Version="3.0.102-alpha" />
    <PackageVersion Include="LibVLCSharp" Version="3.8.2" />
    <PackageVersion Include="LibVLCSharp.Avalonia" Version="3.8.2" />
    <PackageVersion Include="LoadingIndicators.Avalonia" Version="11.0.11.1" />
    <PackageVersion Include="Magick.NET-Q16-HDRI-AnyCPU" Version="14.15.0" />
    <PackageVersion Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.1.0" />
    <PackageVersion Include="Microsoft.Reactive.Testing" Version="5.0.0" />
    <PackageVersion Include="Moq" Version="4.17.2" />
    <PackageVersion Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.1.1" />
    <PackageVersion Include="NaturalSort.Extension" Version="4.2.0" />
    <PackageVersion Include="NDILibDotNetCoreBase" Version="2024.7.22.1" />
    <PackageVersion Include="NetOfficeFw.PowerPoint" Version="1.9.7" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="PDFiumCore" Version="130.0.6693" />
    <PackageVersion Include="protobuf-net" Version="3.2.30" />
    <PackageVersion Include="ReactiveHistory" Version="0.10.7" />
    <!-- Required by ReactiveUI.Avalonia 12.0.3's own dependency floor. -->
    <PackageVersion Include="ReactiveUI" Version="23.2.28" />
    <PackageVersion Include="Splat" Version="19.4.1" />
    <PackageVersion Include="RtfDomParser" Version="7.0.0" />
    <PackageVersion Include="Serilog" Version="3.1.1" />
    <PackageVersion Include="Serilog.Expressions" Version="4.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="5.0.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="2.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="5.0.1-dev-00968" />
    <PackageVersion Include="SIL.Scripture" Version="11.0.1" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="Syncfusion.Licensing" Version="25.1.37" />
    <PackageVersion Include="Syncfusion.Presentation.NET" Version="25.1.35" />
    <PackageVersion Include="Syncfusion.PresentationRenderer.NET" Version="25.1.35" />
    <PackageVersion Include="System.Collections.Concurrent" Version="4.3.0" />
    <PackageVersion Include="System.Net.Http.Json" Version="7.0.0" />
    <PackageVersion Include="System.Reactive" Version="6.1.0" />
    <PackageVersion Include="VideoLAN.LibVLC.Mac" Version="3.1.3.1" />
    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
    <PackageVersion Include="WebView.Avalonia" Version="11.0.0.1" />
    <PackageVersion Include="WebView.Avalonia.Desktop" Version="11.0.0.1" />
    <PackageVersion Include="WebView2.Avalonia" Version="1.0.1518.46-preview.230207.17" />
    <PackageVersion Include="XamlColorSchemeGenerator" Version="3.0.0.31" />
    <PackageVersion Include="XamlNameReferenceGenerator" Version="1.6.1" />
    <PackageVersion Include="xunit" Version="2.4.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.4.3" />
    <PackageVersion Include="YamlDotNet" Version="13.7.1" />
    <PackageVersion Include="CppSharp" Version="1.0.45.22293" />
    <PackageVersion Include="Microsoft.Net.Compilers.Toolset" Version="4.6.0-1.final" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.2.0" />
  </ItemGroup>
</Project>