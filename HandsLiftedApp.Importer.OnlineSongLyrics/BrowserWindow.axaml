<Window
    ExtendClientAreaToDecorationsHint="True"
    Height="650"
    RequestedThemeVariant="Light"
    Title="Import Song"
    Width="900"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d"
    x:Class="HandsLiftedApp.Importer.OnlineSongLyrics.BrowserWindow"
    x:DataType="onlineSongLyrics:BrowserWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:onlineSongLyrics="clr-namespace:HandsLiftedApp.Importer.OnlineSongLyrics"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <onlineSongLyrics:BrowserWindowViewModel />
    </Design.DataContext>

    <DockPanel Margin="0,18,0,0">

        <DockPanel>

            <DockPanel>

                <StackPanel DockPanel.Dock="Top">
                    <StackPanel.Styles>
                        <Style Selector="Ellipse">
                            <Setter Property="Width" Value="30" />
                            <Setter Property="Height" Value="30" />
                            <Setter Property="Fill" Value="DarkSlateBlue" />
                        </Style>
                        <Style Selector="StackPanel &gt; Grid:not(:last-child)">
                            <Setter Property="Margin" Value="0 0 0 18" />
                        </Style>
                        <Style Selector="TextBlock.Number">
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontSize" Value="16" />
                        </Style>
                        <Style Selector="TextBlock.Main">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </StackPanel.Styles>

                    <Grid>
                        <TextBlock Classes="Main" Margin="16,12,0,0">
                            Import lyrics using the web browser
                        </TextBlock>
                    </Grid>

                    <Grid ColumnDefinitions="64,*">
                        <Grid>
                            <Ellipse />
                            <TextBlock Classes="Number">1</TextBlock>
                        </Grid>
                        <TextBlock Classes="Main" Grid.Column="1">Search for the song</TextBlock>
                    </Grid>

                    <Grid ColumnDefinitions="64,*">
                        <Grid>
                            <Ellipse />
                            <TextBlock Classes="Number">2</TextBlock>
                        </Grid>
                        <TextBlock Classes="Main" Grid.Column="1">Copy lyrics to the clipboard</TextBlock>
                    </Grid>

                    <Grid ColumnDefinitions="64,*">
                        <Grid>
                            <Ellipse />
                            <TextBlock Classes="Number">3</TextBlock>
                        </Grid>
                        <TextBlock Classes="Main" Grid.Column="1">Click the import button</TextBlock>
                    </Grid>

                    <Button
                        Click="Button_OnClick"
                        DockPanel.Dock="Bottom"
                        HorizontalAlignment="Center">
                        <DockPanel Margin="3,2">
                            <avalonia:MaterialIcon
                                Height="30"
                                Kind="ArrowRightCircleOutline"
                                Margin="0,0,8,0"
                                Width="30" />
                            <TextBlock FontSize="16" VerticalAlignment="Center">Continue</TextBlock>
                        </DockPanel>
                    </Button>
                </StackPanel>


                <Button
                    Click="CopyLyricsButton_OnClick"
                    DockPanel.Dock="Bottom"
                    IsVisible="{Binding IsSongPage}"
                    ToolTip.Tip="Copy Lyrics">
                    <DockPanel>
                        <TextBlock Text="Select this song" />
                        <avalonia:MaterialIcon Kind="ContentCopy" />
                    </DockPanel>
                </Button>


                <Border
                    Background="ForestGreen"
                    BorderThickness="0,0,0,0"
                    IsVisible="{Binding SelectedClipboardData, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    MaxHeight="60"
                    VerticalAlignment="Bottom">
                    <DockPanel>

                        <avalonia:MaterialIcon
                            Foreground="White"
                            Height="30"
                            Kind="About"
                            Margin="16,8,8,8"
                            Width="30" />

                        <Button
                            Background="#145414"
                            BorderThickness="0"
                            Click="ImportSongButton_OnClick"
                            CornerRadius="0"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Stretch">
                            <DockPanel Margin="3,2">
                                <avalonia:MaterialIcon
                                    Foreground="White"
                                    Height="30"
                                    Kind="ArrowRightCircleOutline"
                                    Margin="0,0,8,0"
                                    Width="30" />
                                <TextBlock
                                    FontSize="16"
                                    Foreground="White"
                                    VerticalAlignment="Center">
                                    Import song
                                </TextBlock>
                            </DockPanel>
                        </Button>
                        <TextBlock
                            Foreground="White"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            x:Name="PART_SelectionText">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{} Selected song: '{0}'">
                                    <Binding Path="SelectedClipboardDataTitle" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DockPanel>
                </Border>
            </DockPanel>

            <Border
                Background="LightGray"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Stretch"
                Margin="4"
                Padding="2">
                <Carousel Name="Carousel" SelectedIndex="0">
                    <ScrollViewer />

                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <ProgressBar
                                IsHitTestVisible="False"
                                IsIndeterminate="True"
                                IsVisible="False"
                                VerticalAlignment="Bottom"
                                x:Name="PART_ProgressBar" />
                            <DockPanel>
                                <DockPanel.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                    <Style Selector="Button &gt; avalonia|MaterialIcon">
                                        <Setter Property="Foreground" Value="#444" />
                                        <Setter Property="MinWidth" Value="26" />
                                        <Setter Property="MinHeight" Value="26" />
                                        <Setter Property="CornerRadius" Value="0" />
                                    </Style>
                                </DockPanel.Styles>
                                <Button Click="BackButton_OnClick">
                                    <avalonia:MaterialIcon Kind="ChevronLeft" />
                                </Button>
                                <Button Click="ForwardButton_OnClick">
                                    <avalonia:MaterialIcon Kind="ChevronRight" />
                                </Button>
                                <Button Click="ReloadButton_OnClick">
                                    <avalonia:MaterialIcon Kind="Refresh" />
                                </Button>
                                <!-- <Button Click="WarningButton_OnClick"> -->
                                <!--     <avalonia:MaterialIcon Kind="Warning" /> -->
                                <!-- </Button> -->
                                <!-- <Button Click="WarningButton2_OnClick"> -->
                                <!--     <avalonia:MaterialIcon Kind="Warning" /> -->
                                <!-- </Button> -->
                                <Button Click="ReloadButton_OnClick" DockPanel.Dock="Right">
                                    <avalonia:MaterialIcon Kind="DotsVertical" />
                                </Button>
                                <TextBox
                                    IsReadOnly="True"
                                    Text="{Binding CurrentUrl}"
                                    VerticalContentAlignment="Center" />
                            </DockPanel>
                        </Grid>
                        <Border
                            Background="White"
                            BorderBrush="DimGray"
                            BorderThickness="1"
                            CornerRadius="0"
                            Margin="1"
                            Padding="2">
                            <NativeWebView x:Name="PART_WebView" />
                        </Border>
                    </DockPanel>
                </Carousel>
            </Border>


        </DockPanel>
    </DockPanel>
</Window>