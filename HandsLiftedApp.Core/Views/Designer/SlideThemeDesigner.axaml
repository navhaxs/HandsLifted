<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="HandsLiftedApp.Core.Views.Designer.SlideThemeDesigner"
    x:CompileBindings="False"
    x:DataType="viewModels:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:HandsLiftedApp.Controls;assembly=HandsLiftedApp.Controls"
    xmlns:converters="using:Avalonia.Markup.Xaml.Converters"
    xmlns:converters1="clr-namespace:HandsLiftedApp.Controls.Converters;assembly=HandsLiftedApp.Controls"
    xmlns:converters2="clr-namespace:HandsLiftedApp.Core.Converters"
    xmlns:core="clr-namespace:HandsLiftedApp.Core"
    xmlns:coreControls="clr-namespace:HandsLiftedApp.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:designer="clr-namespace:HandsLiftedApp.Core.Views.Designer"
    xmlns:ext="using:HandsLiftedApp.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:HandsLiftedApp.Core.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrush" />
        <converters1:XmlColorToBrushConverter x:Key="XmlColorToBrush" />
        <ext:BitmapAssetValueConverter x:Key="variableImage" />
        <converters1:SafeFontWeightConverter x:Key="SafeFontWeightConverter" />
        <converters2:SlideThemeToPreviewConverter x:Key="SlideThemeToPreviewConverter" />
        <converters2:IsDefaultThemeConverter x:Key="IsDefaultThemeConverter" />
        <converters2:IsDefaultSongThemeConverter x:Key="IsDefaultSongThemeConverter" />
        <converters2:IsDefaultSongMotionThemeConverter x:Key="IsDefaultSongMotionThemeConverter" />
        <converters2:IsDefaultScriptureThemeConverter x:Key="IsDefaultScriptureThemeConverter" />
        <converters2:IsGeneralThemeTypeConverter x:Key="IsGeneralThemeTypeConverter" />
        <converters2:IsSongThemeTypeConverter x:Key="IsSongThemeTypeConverter" />
        <converters2:IsScriptureThemeTypeConverter x:Key="IsScriptureThemeTypeConverter" />
        <converters2:RadioMenuIconConverter x:Key="RadioMenuIconConverter" />
        <converters2:IsDifferentThemeTypeConverter x:Key="IsDifferentThemeTypeConverter" />
        <converters2:IsMotionBackgroundModeConverter x:Key="IsMotionBackgroundModeConverter" />

        <ContextMenu x:Key="DesignListItemContextMenu">
            <MenuItem Click="ExportItem_OnClick" Header="Export">
                <MenuItem.Icon>
                    <avalonia:MaterialIcon Foreground="#888888" Kind="ContentSave" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="DuplicateItem_OnClick" Header="Duplicate">
                <MenuItem.Icon>
                    <avalonia:MaterialIcon Foreground="#888888" Kind="ContentCopy" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="RemoveItem_OnClick" Header="Remove">
                <MenuItem.Icon>
                    <avalonia:MaterialIcon Foreground="#888888" Kind="Times" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Move to">
                <MenuItem.Icon>
                    <avalonia:MaterialIcon Foreground="#888888" Kind="SwapHorizontal" />
                </MenuItem.Icon>
                <MenuItem
                    Click="MoveToGroup_OnClick"
                    Header="General"
                    IsEnabled="{Binding Type, Converter={StaticResource IsDifferentThemeTypeConverter}, ConverterParameter=General}"
                    Tag="General">
                    <MenuItem.Icon>
                        <avalonia:MaterialIcon Foreground="#888888" Kind="{Binding Type, Converter={StaticResource RadioMenuIconConverter}, ConverterParameter=General}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Click="MoveToGroup_OnClick"
                    Header="Song Theme"
                    IsEnabled="{Binding Type, Converter={StaticResource IsDifferentThemeTypeConverter}, ConverterParameter=SongTheme}"
                    Tag="SongTheme">
                    <MenuItem.Icon>
                        <avalonia:MaterialIcon Foreground="#888888" Kind="{Binding Type, Converter={StaticResource RadioMenuIconConverter}, ConverterParameter=SongTheme}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Click="MoveToGroup_OnClick"
                    Header="Scripture Theme"
                    IsEnabled="{Binding Type, Converter={StaticResource IsDifferentThemeTypeConverter}, ConverterParameter=ScriptureTheme}"
                    Tag="ScriptureTheme">
                    <MenuItem.Icon>
                        <avalonia:MaterialIcon Foreground="#888888" Kind="{Binding Type, Converter={StaticResource RadioMenuIconConverter}, ConverterParameter=ScriptureTheme}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Click="SetDefaultSongTheme_OnClick" Header="Set as default for Songs">
                <MenuItem.Icon>
                    <avalonia:MaterialIcon Foreground="#888888" Kind="Star" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="SetDefaultSongMotionTheme_OnClick" Header="Set as default for Songs (motion bg)">
                <MenuItem.Icon>
                    <avalonia:MaterialIcon Foreground="#888888" Kind="Star" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="SetDefaultScriptureTheme_OnClick" Header="Set as default for Scripture">
                <MenuItem.Icon>
                    <avalonia:MaterialIcon Foreground="#888888" Kind="Star" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <DataTemplate x:Key="DesignListItemTemplate">
            <DockPanel>
                <TextBlock
                    DockPanel.Dock="Bottom"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,0"
                    Text="{Binding Name}" />
                <TextBlock
                    DockPanel.Dock="Bottom"
                    FontSize="10"
                    Foreground="#888888"
                    HorizontalAlignment="Left"
                    IsVisible="{Binding ., Converter={StaticResource IsDefaultThemeConverter}}"
                    Text="default" />
                <TextBlock
                    DockPanel.Dock="Bottom"
                    FontSize="10"
                    Foreground="#888888"
                    HorizontalAlignment="Left"
                    Text="default (songs)">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{StaticResource IsDefaultSongThemeConverter}">
                            <Binding Path="." />
                            <Binding Source="{x:Static core:Globals.Instance}" Path="AppPreferences.DefaultSongThemeId" /><Binding Path="$parent[UserControl].DataContext.Playlist.DefaultSongThemeId" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <TextBlock
                    DockPanel.Dock="Bottom"
                    FontSize="10"
                    Foreground="#888888"
                    HorizontalAlignment="Left"
                    Text="default (songs, motion)">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{StaticResource IsDefaultSongMotionThemeConverter}">
                            <Binding Path="." />
                            <Binding Source="{x:Static core:Globals.Instance}" Path="AppPreferences.DefaultSongMotionThemeId" /><Binding Path="$parent[UserControl].DataContext.Playlist.DefaultSongMotionThemeId" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
                <TextBlock
                    DockPanel.Dock="Bottom"
                    FontSize="10"
                    Foreground="#888888"
                    HorizontalAlignment="Left"
                    Text="default (scripture)">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{StaticResource IsDefaultScriptureThemeConverter}">
                            <Binding Path="." />
                            <Binding Source="{x:Static core:Globals.Instance}" Path="AppPreferences.DefaultScriptureThemeId" /><Binding Path="$parent[UserControl].DataContext.Playlist.DefaultScriptureThemeId" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.SectionHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0 0 0 6" />
        </Style>
    </UserControl.Styles>

    <Design.DataContext>
        <viewModels:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <!--  List  -->
        <DockPanel DockPanel.Dock="Left">
            <UniformGrid
                Columns="3"
                DockPanel.Dock="Bottom"
                Rows="1">
                <Button Click="AddItem_OnClick" Tag="General">+ General</Button>
                <Button Click="AddItem_OnClick" Tag="SongTheme">+ Song</Button>
                <Button Click="AddItem_OnClick" Tag="ScriptureTheme">+ Scripture</Button>
            </UniformGrid>
            <ScrollViewer>
                <StackPanel MinWidth="80">
                    <TextBlock
                        Classes="SectionHeader"
                        Margin="4,4,4,0"
                        Text="General" />
                    <ListBox
                        ItemTemplate="{StaticResource DesignListItemTemplate}"
                        ItemsSource="{Binding Playlist.Designs}"
                        Name="generalDesignsListBox"
                        SelectionChanged="DesignsListBox_OnSelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="ImportItem_OnClick" Header="Import">
                                    <MenuItem.Icon>
                                        <avalonia:MaterialIcon Foreground="#888888" Kind="FolderOpen" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="IsVisible" Value="{Binding Type, Converter={StaticResource IsGeneralThemeTypeConverter}}" />
                                <Setter Property="ContextMenu" Value="{StaticResource DesignListItemContextMenu}" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>

                    <TextBlock
                        Classes="SectionHeader"
                        Margin="4,10,4,0"
                        Text="Song Themes" />
                    <ListBox
                        ItemTemplate="{StaticResource DesignListItemTemplate}"
                        ItemsSource="{Binding Playlist.Designs}"
                        Name="songDesignsListBox"
                        SelectionChanged="DesignsListBox_OnSelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="ImportItem_OnClick" Header="Import">
                                    <MenuItem.Icon>
                                        <avalonia:MaterialIcon Foreground="#888888" Kind="FolderOpen" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="IsVisible" Value="{Binding Type, Converter={StaticResource IsSongThemeTypeConverter}}" />
                                <Setter Property="ContextMenu" Value="{StaticResource DesignListItemContextMenu}" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>

                    <TextBlock
                        Classes="SectionHeader"
                        Margin="4,10,4,0"
                        Text="Scripture Themes" />
                    <ListBox
                        ItemTemplate="{StaticResource DesignListItemTemplate}"
                        ItemsSource="{Binding Playlist.Designs}"
                        Name="scriptureDesignsListBox"
                        SelectionChanged="DesignsListBox_OnSelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="ImportItem_OnClick" Header="Import">
                                    <MenuItem.Icon>
                                        <avalonia:MaterialIcon Foreground="#888888" Kind="FolderOpen" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="IsVisible" Value="{Binding Type, Converter={StaticResource IsScriptureThemeTypeConverter}}" />
                                <Setter Property="ContextMenu" Value="{StaticResource DesignListItemContextMenu}" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
        <!--  Preview  -->
        <Grid ColumnDefinitions="3*, *">
            <DockPanel Grid.Column="0">
                <StackPanel
                    DockPanel.Dock="Top"
                    Margin="8"
                    Orientation="Horizontal"
                    Spacing="4">
                    <RadioButton
                        Content="Song Lyric"
                        GroupName="ThemePreviewMode"
                        IsChecked="True"
                        IsCheckedChanged="PreviewModeToggle_OnChecked"
                        x:Name="previewLyricToggle" />
                    <RadioButton
                        Content="Song Title"
                        GroupName="ThemePreviewMode"
                        IsCheckedChanged="PreviewModeToggle_OnChecked"
                        x:Name="previewTitleToggle" />
                    <RadioButton
                        Content="Scripture"
                        GroupName="ThemePreviewMode"
                        IsCheckedChanged="PreviewModeToggle_OnChecked"
                        x:Name="previewScriptureToggle" />
                </StackPanel>
                <Viewbox
                    HorizontalAlignment="Stretch"
                    StretchDirection="DownOnly"
                    VerticalAlignment="Stretch">
                    <Grid Height="1080" Width="1920">
                        <designer:SongSlideView
                            Height="1080"
                            Width="1920"
                            x:Name="themePreviewSlideView" />
                        <designer:SongTitleSlideView
                            Height="1080"
                            IsVisible="False"
                            Width="1920"
                            x:Name="themePreviewTitleSlideView" />
                        <designer:ScriptureSlideView
                            Height="1080"
                            IsVisible="False"
                            Width="1920"
                            x:Name="themePreviewScriptureView" />
                    </Grid>
                </Viewbox>
            </DockPanel>

            <!-- <ScrollViewer Grid.Column="1"> -->
            <!--     <TextBox Text="{Binding #designsListBox.SelectedItem}" /> -->
            <!-- </ScrollViewer> -->

            <ScrollViewer Grid.Column="1">
                <StackPanel Margin="12,8" x:Name="themeEditorPanel">

                    <StackPanel.Styles>
                        <Style Selector="ColorPicker">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                        </Style>
                        <Style Selector="TextBlock.SectionHeader">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Margin" Value="0 0 0 6" />
                        </Style>
                    </StackPanel.Styles>

                    <!--  =============================  -->
                    <!--  Common (applies to all types)  -->
                    <!--  =============================  -->
                    <TextBlock Classes="SectionHeader" Text="Common" />

                    <TextBlock Text="Name" />
                    <TextBox Text="{Binding Name}" Watermark="" />

                    <TextBlock Margin="0,6,0,0" Text="Applies To" />
                    <controls:ComboBoxWithoutWheelScroll
                        HorizontalAlignment="Stretch"
                        SelectedItem="{Binding Type}"
                        x:Name="themeTypeComboBox" />

                    <TextBlock Margin="0,6,0,0" Text="Background" />
                    <controls:ComboBoxWithoutWheelScroll
                        HorizontalAlignment="Stretch"
                        SelectedItem="{Binding BackgroundMode}"
                        x:Name="backgroundModeComboBox" />

                    <StackPanel IsVisible="{Binding BackgroundMode, Converter={StaticResource IsMotionBackgroundModeConverter}}" Margin="0,6,0,0">
                        <TextBlock Text="Default Motion Background Video" />
                        <coreControls:MotionBackgroundVideoPicker VideoPath="{Binding DefaultMotionBackgroundVideoPath}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="2*, *" Margin="0,6,0,0">
                        <StackPanel Grid.Column="0">
                            <!--  "Garamond, Playfair Display"  -->
                            <TextBlock Text="Font" />
                            <controls:ComboBoxWithoutWheelScroll
                                HorizontalAlignment="Stretch"
                                SelectedItem="{Binding FontFamilyAsText}"
                                SelectionChanged="FontComboBox_OnSelectionChanged"
                                x:Name="fontComboBox">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{Binding}" Text="{Binding}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </controls:ComboBoxWithoutWheelScroll>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Font Weight" />
                            <controls:ComboBoxWithoutWheelScroll
                                HorizontalAlignment="Stretch"
                                Name="FontWeightComboBox"
                                SelectedValue="{Binding FontWeight, FallbackValue=SemiBold, Converter={StaticResource SafeFontWeightConverter}}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Background="Transparent"
                        DockPanel.Dock="Top"
                        Margin="0,6">
                        <UniformGrid
                            Columns="4"
                            Height="35"
                            HorizontalAlignment="Left"
                            Rows="1">
                            <UniformGrid.Styles>
                                <Style Selector="RadioButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <ToggleButton
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource OutlineBrush}"
                                                    Content="{Binding Path=Content, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RadioButton}}}"
                                                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    IsChecked="{Binding Path=IsChecked, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RadioButton}}}"
                                                    Padding="8,0"
                                                    VerticalAlignment="{TemplateBinding VerticalAlignment}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style Selector="RadioButton:checked /template/ ToggleButton /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                </Style>
                                <Style Selector="RadioButton:pointerover /template/ ToggleButton /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#b7a6e7" />
                                </Style>
                                <Style Selector="RadioButton /template/ ToggleButton:pressed /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#9072EA" />
                                </Style>
                                <Style Selector="RadioButton:nth-child(1) /template/ ToggleButton">
                                    <Setter Property="CornerRadius" Value="2 0 0 2" />
                                </Style>
                                <Style Selector="RadioButton:nth-last-child(1) /template/ ToggleButton">
                                    <Setter Property="CornerRadius" Value="0 2 2 0" />
                                </Style>
                                <Style Selector="avalonia|MaterialIcon">
                                    <Setter Property="Height" Value="14" />
                                    <Setter Property="Width" Value="14" />
                                </Style>
                            </UniformGrid.Styles>
                            <ToggleButton CornerRadius="6" IsChecked="{Binding CalculatedTextFontBold}">
                                <avalonia:MaterialIcon Kind="FormatBold" />
                            </ToggleButton>
                            <ToggleButton CornerRadius="6" IsChecked="{Binding CalculatedTextFontItalic}">
                                <avalonia:MaterialIcon Kind="FormatItalic" />
                            </ToggleButton>
                            <ToggleButton CornerRadius="6" IsChecked="{Binding CalculatedTextFontUnderline}">
                                <avalonia:MaterialIcon Kind="FormatUnderline" />
                            </ToggleButton>
                        </UniformGrid>
                    </Border>

                    <Border
                        Background="#808080"
                        Height="1"
                        Margin="0,10" />

                    <TextBlock Text="Line Height" />
                    <controls:NumericSliderBox
                        Maximum="3"
                        Minimum="0.1"
                        Text="{Binding LineHeightEm, FallbackValue=1}"
                        TickFrequency="0.01" />

                    <!--  <ComboBox Name="TextAlignmentComboBox"  -->
                    <!--  SelectedItem="{Binding #designsListBox.SelectedItem.TextAlignment}" />  -->
                    <Border
                        Background="#808080"
                        Height="1"
                        Margin="0,10" />

                    <DockPanel>
                        <ColorPicker
                            Color="{Binding TextAvaloniaColour, FallbackValue='White'}"
                            DockPanel.Dock="Right"
                            Name="TextColour" />
                        <TextBlock Text="Colour" />
                    </DockPanel>

                    <Border
                        Background="#808080"
                        Height="1"
                        Margin="0,10" />

                    <TextBlock Text="Background" />

                    <ColorPicker
                        Color="{Binding BackgroundAvaloniaColour, FallbackValue='Black'}"
                        HorizontalAlignment="Right"
                        Name="BackgroundColour" />

                    <TextBlock Text="Graphic" />
                    <DockPanel>
                        <Button Click="ChangeThemeBgGraphic_OnClick" DockPanel.Dock="Right">...</Button>
                        <TextBox
                            Name="bgGraphicFilePath"
                            Text="{Binding BackgroundGraphicFilePath}"
                            Watermark="" />
                    </DockPanel>

                    <Border
                        Background="#808080"
                        Height="1"
                        Margin="0,10" />

                    <DockPanel Margin="0,0,0,4">
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding DropShadowEnabled}" />
                        <TextBlock Text="Drop Shadow" VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel IsEnabled="{Binding DropShadowEnabled}">
                        <Grid ColumnDefinitions="*, *, *">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Offset Y" />
                                <controls:NumericSliderBox
                                    Maximum="100"
                                    Minimum="-100"
                                    Text="{Binding DropShadowOffsetY, FallbackValue=8}"
                                    TextBoxMinWidth="40"
                                    TickFrequency="1" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Offset X" />
                                <controls:NumericSliderBox
                                    Maximum="100"
                                    Minimum="-100"
                                    Text="{Binding DropShadowOffsetX, FallbackValue=0}"
                                    TextBoxMinWidth="40"
                                    TickFrequency="1" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="Blur" />
                                <controls:NumericSliderBox
                                    Maximum="100"
                                    Minimum="0"
                                    Text="{Binding DropShadowBlurRadius, FallbackValue=20}"
                                    TextBoxMinWidth="40"
                                    TickFrequency="1" />
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,4,0,0">
                            <ColorPicker Color="{Binding DropShadowAvaloniaColour, FallbackValue='Black'}" DockPanel.Dock="Right" />
                            <TextBlock Text="Colour" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <!--  =============================  -->
                    <!--  Song Lyric only  -->
                    <!--  =============================  -->
                    <StackPanel IsVisible="{Binding #previewLyricToggle.IsChecked}">

                        <Border
                            Background="#808080"
                            Height="1"
                            Margin="0,10" />
                        <TextBlock Classes="SectionHeader" Text="Song Lyric" />

                        <TextBlock Text="Font Size" />
                        <controls:NumericSliderBox
                            Maximum="400"
                            Minimum="1"
                            Text="{Binding FontSize, FallbackValue=90}"
                            TickFrequency="1" />

                        <TextBlock Margin="0,6,0,0" Text="Text Horizontal Alignment" />
                        <Border
                            Background="Transparent"
                            DockPanel.Dock="Top"
                            Margin="0,6">
                            <UniformGrid
                                Columns="4"
                                Height="35"
                                HorizontalAlignment="Left"
                                Rows="1">
                                <UniformGrid.Styles>
                                    <Style Selector="RadioButton">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <ToggleButton
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource OutlineBrush}"
                                                        Content="{Binding Path=Content, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RadioButton}}}"
                                                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        IsChecked="{Binding Path=IsChecked, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RadioButton}}}"
                                                        Padding="8,0"
                                                        VerticalAlignment="{TemplateBinding VerticalAlignment}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style Selector="RadioButton:checked /template/ ToggleButton /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                    </Style>
                                    <Style Selector="RadioButton:pointerover /template/ ToggleButton /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#b7a6e7" />
                                    </Style>
                                    <Style Selector="RadioButton /template/ ToggleButton:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#9072EA" />
                                    </Style>
                                    <Style Selector="RadioButton:nth-child(1) /template/ ToggleButton">
                                        <Setter Property="CornerRadius" Value="2 0 0 2" />
                                    </Style>
                                    <Style Selector="RadioButton:nth-last-child(1) /template/ ToggleButton">
                                        <Setter Property="CornerRadius" Value="0 2 2 0" />
                                    </Style>
                                    <Style Selector="avalonia|MaterialIcon">
                                        <Setter Property="Height" Value="14" />
                                        <Setter Property="Width" Value="14" />
                                    </Style>
                                </UniformGrid.Styles>
                                <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedTextAlignmentLeft}">
                                    <avalonia:MaterialIcon Kind="AlignHorizontalLeft" />
                                </RadioButton>
                                <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedTextAlignmentCenter}">
                                    <avalonia:MaterialIcon Kind="AlignHorizontalCentre" />
                                </RadioButton>
                                <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedTextAlignmentRight}">
                                    <avalonia:MaterialIcon Kind="AlignHorizontalRight" />
                                </RadioButton>
                                <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedTextAlignmentJustify}">
                                    <avalonia:MaterialIcon Kind="AlignHorizontalDistribute" />
                                </RadioButton>
                            </UniformGrid>
                        </Border>

                        <TextBlock Margin="0,10,0,0" Text="Autofit" />
                        <CheckBox
                            Content="Shrink font to fit stanza"
                            IsChecked="{Binding AutofitEnabled}"
                            Name="AutofitEnabledCheckBox" />
                        <controls:NumericSliderBox
                            IsEnabled="{Binding #AutofitEnabledCheckBox.IsChecked}"
                            Maximum="1.0"
                            Minimum="0.1"
                            Text="{Binding AutofitMinFontSizeRatio, FallbackValue=0.5}"
                            TextBoxMinWidth="30"
                            TickFrequency="0.01" />

                    </StackPanel>

                    <!--  =============================  -->
                    <!--  Song Title only  -->
                    <!--  =============================  -->
                    <StackPanel IsVisible="{Binding #previewTitleToggle.IsChecked}">

                        <Border
                            Background="#808080"
                            Height="1"
                            Margin="0,10" />
                        <TextBlock Classes="SectionHeader" Text="Song Title" />

                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Title Font Size" />
                                <controls:NumericSliderBox
                                    Maximum="400"
                                    Minimum="1"
                                    Text="{Binding TitleFontSize, FallbackValue=100}"
                                    TickFrequency="1" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Copyright Font Size" />
                                <controls:NumericSliderBox
                                    Maximum="150"
                                    Minimum="1"
                                    Text="{Binding CopyrightFontSize, FallbackValue=45}"
                                    TickFrequency="1" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" Margin="0,6,0,0">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Title Horizontal Alignment" />
                                <Border
                                    Background="Transparent"
                                    DockPanel.Dock="Top"
                                    Margin="0,6">
                                    <UniformGrid
                                        Columns="3"
                                        Height="35"
                                        HorizontalAlignment="Left"
                                        Rows="1">
                                        <UniformGrid.Styles>
                                            <Style Selector="RadioButton">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="VerticalAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <ToggleButton
                                                                Background="Transparent"
                                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                                Content="{Binding Path=Content, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RadioButton}}}"
                                                                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                IsChecked="{Binding Path=IsChecked, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RadioButton}}}"
                                                                Padding="8,0"
                                                                VerticalAlignment="{TemplateBinding VerticalAlignment}" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style Selector="RadioButton:checked /template/ ToggleButton /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                            </Style>
                                            <Style Selector="RadioButton:pointerover /template/ ToggleButton /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#b7a6e7" />
                                            </Style>
                                            <Style Selector="RadioButton /template/ ToggleButton:pressed /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#9072EA" />
                                            </Style>
                                            <Style Selector="RadioButton:nth-child(1) /template/ ToggleButton">
                                                <Setter Property="CornerRadius" Value="2 0 0 2" />
                                            </Style>
                                            <Style Selector="RadioButton:nth-last-child(1) /template/ ToggleButton">
                                                <Setter Property="CornerRadius" Value="0 2 2 0" />
                                            </Style>
                                            <Style Selector="avalonia|MaterialIcon">
                                                <Setter Property="Height" Value="14" />
                                                <Setter Property="Width" Value="14" />
                                            </Style>
                                        </UniformGrid.Styles>
                                        <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedTitleTextAlignmentLeft}">
                                            <avalonia:MaterialIcon Kind="AlignHorizontalLeft" />
                                        </RadioButton>
                                        <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedTitleTextAlignmentCenter}">
                                            <avalonia:MaterialIcon Kind="AlignHorizontalCentre" />
                                        </RadioButton>
                                        <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedTitleTextAlignmentRight}">
                                            <avalonia:MaterialIcon Kind="AlignHorizontalRight" />
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Title Vertical Alignment" />
                                <Border
                                    Background="Transparent"
                                    DockPanel.Dock="Top"
                                    Margin="0,6">
                                    <UniformGrid
                                        Columns="3"
                                        Height="35"
                                        HorizontalAlignment="Left"
                                        Rows="1">
                                        <UniformGrid.Styles>
                                            <Style Selector="RadioButton">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="VerticalAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <ToggleButton
                                                                Background="Transparent"
                                                                BorderBrush="{DynamicResource OutlineBrush}"
                                                                Content="{Binding Path=Content, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RadioButton}}}"
                                                                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                IsChecked="{Binding Path=IsChecked, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RadioButton}}}"
                                                                Padding="8,0"
                                                                VerticalAlignment="{TemplateBinding VerticalAlignment}" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style Selector="RadioButton:checked /template/ ToggleButton /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                            </Style>
                                            <Style Selector="RadioButton:pointerover /template/ ToggleButton /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#b7a6e7" />
                                            </Style>
                                            <Style Selector="RadioButton /template/ ToggleButton:pressed /template/ ContentPresenter">
                                                <Setter Property="Background" Value="#9072EA" />
                                            </Style>
                                            <Style Selector="RadioButton:nth-child(1) /template/ ToggleButton">
                                                <Setter Property="CornerRadius" Value="2 0 0 2" />
                                            </Style>
                                            <Style Selector="RadioButton:nth-last-child(1) /template/ ToggleButton">
                                                <Setter Property="CornerRadius" Value="0 2 2 0" />
                                            </Style>
                                            <Style Selector="avalonia|MaterialIcon">
                                                <Setter Property="Height" Value="14" />
                                                <Setter Property="Width" Value="14" />
                                            </Style>
                                        </UniformGrid.Styles>
                                        <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedTitleVerticalAlignmentTop}">
                                            <avalonia:MaterialIcon Kind="AlignVerticalTop" />
                                        </RadioButton>
                                        <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedTitleVerticalAlignmentCenter}">
                                            <avalonia:MaterialIcon Kind="AlignVerticalCenter" />
                                        </RadioButton>
                                        <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedTitleVerticalAlignmentBottom}">
                                            <avalonia:MaterialIcon Kind="AlignVerticalBottom" />
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,6,0,0" Text="Copyright Alignment" />
                        <Border
                            Background="Transparent"
                            DockPanel.Dock="Top"
                            Margin="0,6">
                            <UniformGrid
                                Columns="3"
                                Height="35"
                                HorizontalAlignment="Left"
                                Rows="1">
                                <UniformGrid.Styles>
                                    <Style Selector="RadioButton">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="VerticalAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <ToggleButton
                                                        Background="Transparent"
                                                        BorderBrush="{DynamicResource OutlineBrush}"
                                                        Content="{Binding Path=Content, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RadioButton}}}"
                                                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        IsChecked="{Binding Path=IsChecked, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type RadioButton}}}"
                                                        Padding="8,0"
                                                        VerticalAlignment="{TemplateBinding VerticalAlignment}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style Selector="RadioButton:checked /template/ ToggleButton /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryActionBrush}" />
                                    </Style>
                                    <Style Selector="RadioButton:pointerover /template/ ToggleButton /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#b7a6e7" />
                                    </Style>
                                    <Style Selector="RadioButton /template/ ToggleButton:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#9072EA" />
                                    </Style>
                                    <Style Selector="RadioButton:nth-child(1) /template/ ToggleButton">
                                        <Setter Property="CornerRadius" Value="2 0 0 2" />
                                    </Style>
                                    <Style Selector="RadioButton:nth-last-child(1) /template/ ToggleButton">
                                        <Setter Property="CornerRadius" Value="0 2 2 0" />
                                    </Style>
                                    <Style Selector="avalonia|MaterialIcon">
                                        <Setter Property="Height" Value="14" />
                                        <Setter Property="Width" Value="14" />
                                    </Style>
                                </UniformGrid.Styles>
                                <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedCopyrightTextAlignmentLeft}">
                                    <avalonia:MaterialIcon Kind="AlignHorizontalLeft" />
                                </RadioButton>
                                <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedCopyrightTextAlignmentCenter}">
                                    <avalonia:MaterialIcon Kind="AlignHorizontalCentre" />
                                </RadioButton>
                                <RadioButton CornerRadius="6" IsChecked="{Binding CalculatedCopyrightTextAlignmentRight}">
                                    <avalonia:MaterialIcon Kind="AlignHorizontalRight" />
                                </RadioButton>
                            </UniformGrid>
                        </Border>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>

</UserControl>
