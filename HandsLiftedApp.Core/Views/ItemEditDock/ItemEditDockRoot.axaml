<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="HandsLiftedApp.Core.Views.ItemEditDock.ItemEditDockRoot"
    x:DataType="items:Item"
    xmlns="https://github.com/avaloniaui"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:common="clr-namespace:HandsLiftedApp.Common;assembly=HandsLiftedApp.Common"
    xmlns:controls="clr-namespace:HandsLiftedApp.Core.Controls"
    xmlns:converters="clr-namespace:HandsLiftedApp.Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:itemEditDock="clr-namespace:HandsLiftedApp.Core.Views.ItemEditDock"
    xmlns:items="clr-namespace:HandsLiftedApp.Data.Models.Items;assembly=HandsLiftedApp.Data"
    xmlns:items1="clr-namespace:HandsLiftedApp.Core.Models.RuntimeData.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:slideTheme="clr-namespace:HandsLiftedApp.Data.SlideTheme;assembly=HandsLiftedApp.Data"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <converters:PrependBlankThemeOptionConverter x:Key="PrependBlankThemeOptionConverter" />
        <converters:AppliesToSongsVisibilityConverter x:Key="AppliesToSongsVisibilityConverter" />
        <converters:AppliesToScriptureVisibilityConverter x:Key="AppliesToScriptureVisibilityConverter" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6 0 6 6" />
        </Style>
        <Style Selector="Button.menuRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.menuRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22ffffff" />
        </Style>
    </UserControl.Styles>
    <ContentControl Content="{Binding}">
        <ContentControl.ContentTemplate>
            <common:MyTemplateSelector>
                <DataTemplate x:DataType="items1:SongItemInstance" x:Key="SongItemInstance">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            Background="{DynamicResource EditButtonBackgroundBrush}"
                            BorderBrush="#b3aed9"
                            BorderThickness="1"
                            CornerRadius="4"
                            IsVisible="{Binding ShowMotionBackgroundVideoButton}"
                            Margin="6,6,0,6"
                            Padding="8,6"
                            ToolTip.Tip="Motion background video override">
                            <TextBlock>Background</TextBlock>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <controls:MotionBackgroundVideoPicker
                                        Margin="8"
                                        VideoPath="{Binding MotionBackgroundVideoOverride}"
                                        VideoPathPicked="MotionVideoPicker_OnVideoPathPicked" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <itemEditDock:ItemEditMenuButton>
                            <itemEditDock:ItemEditMenuButton.ExtraRows>
                                <Button Classes="menuRow">
                                    <DockPanel>
                                        <avalonia:MaterialIcon Kind="Palette" Margin="0,0,8,0" />
                                        <TextBlock>Theme</TextBlock>
                                    </DockPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="RightEdgeAlignedTop">
                                            <DockPanel LastChildFill="True" MinWidth="180">
                                                <Button
                                                    Click="ClearThemeButton_OnClick"
                                                    DockPanel.Dock="Right"
                                                    Margin="4,0,0,0"
                                                    Padding="6,0"
                                                    ToolTip.Tip="Use fallback theme">
                                                    <TextBlock>✕</TextBlock>
                                                </Button>
                                                <ComboBox
                                                    HorizontalAlignment="Stretch"
                                                    ItemsSource="{Binding ParentPlaylist.Designs}"
                                                    SelectedItem="{Binding ResolvedDesignTheme}">
                                                    <ComboBox.Styles>
                                                        <Style Selector="ComboBoxItem" x:DataType="slideTheme:BaseSlideTheme">
                                                            <Setter Property="IsVisible" Value="{Binding Converter={StaticResource AppliesToSongsVisibilityConverter}}" />
                                                        </Style>
                                                    </ComboBox.Styles>
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DockPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </itemEditDock:ItemEditMenuButton.ExtraRows>
                        </itemEditDock:ItemEditMenuButton>
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="items1:ScriptureItemInstance" x:Key="ScriptureItemInstance">
                    <itemEditDock:ItemEditMenuButton>
                        <itemEditDock:ItemEditMenuButton.ExtraRows>
                            <Button Classes="menuRow">
                                <DockPanel>
                                    <avalonia:MaterialIcon Kind="Palette" Margin="0,0,8,0" />
                                    <TextBlock>Theme</TextBlock>
                                </DockPanel>
                                <Button.Flyout>
                                    <Flyout Placement="RightEdgeAlignedTop">
                                        <DockPanel LastChildFill="True" MinWidth="180">
                                            <Button
                                                Click="ClearThemeButton_OnClick"
                                                DockPanel.Dock="Right"
                                                Margin="4,0,0,0"
                                                Padding="6,0"
                                                ToolTip.Tip="Use fallback theme">
                                                <TextBlock>✕</TextBlock>
                                            </Button>
                                            <ComboBox
                                                HorizontalAlignment="Stretch"
                                                ItemsSource="{Binding ParentPlaylist.Designs, Converter={StaticResource PrependBlankThemeOptionConverter}}"
                                                SelectedItem="{Binding ExplicitDesignTheme}">
                                                <ComboBox.Styles>
                                                    <Style Selector="ComboBoxItem" x:DataType="slideTheme:BaseSlideTheme">
                                                        <Setter Property="IsVisible" Value="{Binding Converter={StaticResource AppliesToScriptureVisibilityConverter}}" />
                                                    </Style>
                                                </ComboBox.Styles>
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name, FallbackValue=''}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DockPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </itemEditDock:ItemEditMenuButton.ExtraRows>
                    </itemEditDock:ItemEditMenuButton>
                </DataTemplate>
                <DataTemplate x:DataType="items1:PowerPointPresentationItemInstance" x:Key="PowerPointPresentationItemInstance">
                    <StackPanel Orientation="Horizontal">
                        <itemEditDock:ItemAutoplayIndicator />
                        <itemEditDock:ItemEditMenuButton>
                            <itemEditDock:ItemEditMenuButton.ExtraRows>
                                <StackPanel>
                                    <itemEditDock:ItemTimer DataContext="{Binding AutoAdvanceTimer}" />
                                    <Button Classes="menuRow">
                                        <DockPanel>
                                            <avalonia:MaterialIcon Kind="Sync" Margin="0,0,8,0" />
                                            <TextBlock>Sync</TextBlock>
                                        </DockPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedTop">
                                                <StackPanel Margin="6" MinWidth="200">
                                                    <TextBlock TextAlignment="Center">PowerPoint Presentation</TextBlock>
                                                    <TextBlock TextAlignment="Center">
                                                        File:<Run Text="{Binding SourcePresentationFile}" />
                                                    </TextBlock>
                                                    <TextBlock TextAlignment="Center">
                                                        Last Sync:<Run Text="{Binding LastSyncDateTime}" />
                                                    </TextBlock>
                                                    <Button Click="PowerPoint_EditButton_OnClick" Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <avalonia:MaterialIcon Kind="Pencil" Margin="0,0,5,0" />
                                                            <TextBlock>Edit in PowerPoint</TextBlock>
                                                        </DockPanel>
                                                    </Button>
                                                    <Button Click="Button_OnClick" Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <avalonia:MaterialIcon Kind="Sync" Margin="0,0,5,0" />
                                                            <TextBlock>Sync</TextBlock>
                                                        </DockPanel>
                                                    </Button>
                                                    <Button Click="PowerPoint_ChangeFileButton_OnClick" Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <avalonia:MaterialIcon Kind="SwapHorizontal" Margin="0,0,5,0" />
                                                            <TextBlock>Change file</TextBlock>
                                                        </DockPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </itemEditDock:ItemEditMenuButton.ExtraRows>
                        </itemEditDock:ItemEditMenuButton>
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="items1:GoogleSlidesGroupItemInstance" x:Key="GoogleSlidesGroupItemInstance">
                    <StackPanel Orientation="Horizontal">
                        <itemEditDock:ItemAutoplayIndicator />
                        <itemEditDock:ItemEditMenuButton>
                            <itemEditDock:ItemEditMenuButton.ExtraRows>
                                <StackPanel>
                                    <itemEditDock:ItemTimer DataContext="{Binding AutoAdvanceTimer}" />
                                    <Button Classes="menuRow">
                                        <DockPanel>
                                            <avalonia:MaterialIcon Kind="Sync" Margin="0,0,8,0" />
                                            <TextBlock>Sync</TextBlock>
                                        </DockPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedTop">
                                                <StackPanel Margin="6" MinWidth="200">
                                                    <TextBlock TextAlignment="Center">
                                                        Last Sync:<Run Text="{Binding LastSyncDateTime}" />
                                                    </TextBlock>
                                                    <Button Click="Button_OnClick" Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <avalonia:MaterialIcon Kind="Sync" Margin="0,0,5,0" />
                                                            <TextBlock>Sync</TextBlock>
                                                        </DockPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </itemEditDock:ItemEditMenuButton.ExtraRows>
                        </itemEditDock:ItemEditMenuButton>
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="items1:PDFSlidesGroupItemInstance" x:Key="PDFSlidesGroupItemInstance">
                    <StackPanel Orientation="Horizontal">
                        <itemEditDock:ItemAutoplayIndicator />
                        <itemEditDock:ItemEditMenuButton>
                            <itemEditDock:ItemEditMenuButton.ExtraRows>
                                <StackPanel>
                                    <itemEditDock:ItemTimer DataContext="{Binding AutoAdvanceTimer}" />
                                    <Button Classes="menuRow">
                                        <DockPanel>
                                            <avalonia:MaterialIcon Kind="Sync" Margin="0,0,8,0" />
                                            <TextBlock>Sync</TextBlock>
                                        </DockPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedTop">
                                                <StackPanel Margin="6" MinWidth="200">
                                                    <TextBlock TextAlignment="Center">
                                                        Last Sync:<Run Text="{Binding LastSyncDateTime}" />
                                                    </TextBlock>
                                                    <Button Click="Button_OnClick" Margin="0,6,0,0">
                                                        <DockPanel>
                                                            <avalonia:MaterialIcon Kind="Sync" Margin="0,0,5,0" />
                                                            <TextBlock>Sync</TextBlock>
                                                        </DockPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </itemEditDock:ItemEditMenuButton.ExtraRows>
                        </itemEditDock:ItemEditMenuButton>
                    </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="items1:MediaGroupItemInstance" x:Key="MediaGroupItemInstance">
                    <StackPanel Orientation="Horizontal">
                        <itemEditDock:ItemAutoplayIndicator />
                        <itemEditDock:ItemEditMenuButton>
                            <itemEditDock:ItemEditMenuButton.ExtraRows>
                                <itemEditDock:ItemTimer DataContext="{Binding AutoAdvanceTimer}" />
                            </itemEditDock:ItemEditMenuButton.ExtraRows>
                        </itemEditDock:ItemEditMenuButton>
                    </StackPanel>
                </DataTemplate>
            </common:MyTemplateSelector>
        </ContentControl.ContentTemplate>
    </ContentControl>
</UserControl>
