<UserControl
    d:DesignHeight="150"
    d:DesignWidth="300"
    mc:Ignorable="d"
    x:Class="HandsLiftedApp.Views.ControlModules.AutoAdvanceTimerControlViewWrapper"
    x:DataType="utils1:AutoAdvanceTimerController"
    xmlns="https://github.com/avaloniaui"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:common="clr-namespace:HandsLiftedApp.Common;assembly=HandsLiftedApp.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils1="clr-namespace:HandsLiftedApp.Core.Utils"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.DataContext>
        <utils1:AutoAdvanceTimerController IsTimerConfigured="True" PrettyTimerInterval="1m, 30s" />
    </Design.DataContext>
    <UserControl.Styles>
        <Style Selector="DockPanel.blinking">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.2" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <ContentControl Content="{Binding}">
        <ContentControl.ContentTemplate>
            <common:MyTemplateSelector>
                <DataTemplate DataType="utils1:AutoAdvanceTimerController" x:Key="AutoAdvanceTimerController">
                    <Border
                        Background="#3a344a"
                        CornerRadius="0 0 0 0"
                        IsVisible="{Binding IsTimerConfigured}"
                        Margin="6"
                        VerticalAlignment="Top">
                        <StackPanel>

                            <Grid DockPanel.Dock="Top" Height="2">
                                <ProgressBar
                                    IsVisible="{Binding IsTimerConfigured}"
                                    Maximum="{Binding Timer.TotalTime, FallbackValue=0}"
                                    MinHeight="2"
                                    Value="{Binding Timer.ElapsedTime, FallbackValue=0}" />
                            </Grid>

                            <DockPanel Margin="0" VerticalAlignment="Center">

                                <DockPanel Margin="0">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,6,6,0">
                                        <TextBlock
                                            FontSize="14"
                                            Margin="6,0,0,0"
                                            Text="Autoplay timer"
                                            VerticalAlignment="Center" />
                                    </DockPanel>
                                    <DockPanel
                                        HorizontalAlignment="Stretch"
                                        Margin="6"
                                        VerticalAlignment="Center">
                                        <StackPanel
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,0">
                                            <Button Click="ResumeButton_OnClick" IsVisible="{Binding !Timer.Enabled}">
                                                <DockPanel>
                                                    <avalonia:MaterialIcon Kind="Play" />
                                                    <TextBlock Text="Resume" />
                                                </DockPanel>
                                            </Button>
                                            <Button Click="PauseButton_OnClick" IsVisible="{Binding Timer.Enabled}">
                                                <DockPanel>
                                                    <avalonia:MaterialIcon Kind="Pause" />
                                                    <TextBlock Text="Pause" />
                                                </DockPanel>
                                            </Button>
                                        </StackPanel>

                                        <DockPanel Classes.blinking="{Binding !Timer.Enabled}">
                                            <avalonia:MaterialIcon
                                                Height="20"
                                                Kind="TimerOutline"
                                                Width="20" />
                                            <TextBlock Text="{Binding PrettyTimerInterval}" VerticalAlignment="Center" />
                                            <TextBlock
                                                IsVisible="{Binding !Timer.Enabled}"
                                                Margin="6,0,0,0"
                                                Text="- Paused"
                                                VerticalAlignment="Center" />
                                        </DockPanel>



                                    </DockPanel>

                                </DockPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </common:MyTemplateSelector>
        </ContentControl.ContentTemplate>
    </ContentControl>
</UserControl>