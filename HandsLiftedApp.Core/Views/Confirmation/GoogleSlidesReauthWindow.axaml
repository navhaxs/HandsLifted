<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="400"
        Height="175"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        x:Class="HandsLiftedApp.Core.Views.Confirmation.GoogleSlidesReauthWindow"
        Icon="/Assets/app.ico"
        Title="Google Sign-In Required">
    <Border CornerRadius="8"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <DockPanel Margin="15">
            <StackPanel Margin="0 10 0 0" DockPanel.Dock="Bottom" Classes="dialog-buttons"
                        Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                <Button Content="Sign In with Google" IsDefault="True" Click="OnConfirm" />
                <Button Content="Cancel" Click="OnCancel" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Google Sign-In Required"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold"
                           Margin="10 10 0 0"
                           FontSize="14" />
                <TextBlock Text="Your Google account session has expired. Click Sign In to open a browser window and re-authenticate, then try syncing again."
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="10 10 10 0"
                           FontSize="14" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
