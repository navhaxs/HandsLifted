<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="420"
        Height="190"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        x:Class="HandsLiftedApp.Core.Views.OnlineVideoUrlDialog"
        Icon="/Assets/app.ico"
        Title="Add Online Video">
    <Border CornerRadius="8"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1">
        <DockPanel Margin="15">
            <StackPanel Margin="0 10 0 0" DockPanel.Dock="Bottom"
                        Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                <Button Content="Add" x:Name="AddButton" IsDefault="True" IsEnabled="False" Click="OnConfirmAdd" />
                <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Add Online Video" FontWeight="SemiBold" FontSize="14" Margin="0 4 0 0" />
                <TextBlock Text="Works with YouTube, Vimeo, and most other video sites (via yt-dlp)."
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
                <TextBox x:Name="UrlTextBox" Watermark="https://..." TextChanged="OnUrlTextChanged" />
                <TextBlock x:Name="HintText" FontSize="11" Foreground="IndianRed" MinHeight="16" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
