<UserControl
    d:DesignHeight="400"
    d:DesignWidth="200"
    mc:Ignorable="d"
    x:Class="HandsLiftedApp.Core.Controls.Navigation.ItemOrderListView"
    x:DataType="models:PlaylistInstance"
    xmlns="https://github.com/avaloniaui"
    xmlns:avaloniaconverters="using:Avalonia.Markup.Xaml.Converters"
    xmlns:behaviours="using:HandsLiftedApp.Behaviours"
    xmlns:common="clr-namespace:HandsLiftedApp.Common;assembly=HandsLiftedApp.Common"
    xmlns:converters="using:HandsLiftedApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Xaml.Behaviors.Interactivity"
    xmlns:items="clr-namespace:HandsLiftedApp.Data.Models.Items;assembly=HandsLiftedApp.Data"
    xmlns:items1="clr-namespace:HandsLiftedApp.Controls.Items;assembly=HandsLiftedApp.Controls"
    xmlns:material="using:Material.Icons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mockData1="clr-namespace:HandsLiftedApp.Controls.MockData;assembly=HandsLiftedApp.Controls"
    xmlns:models="clr-namespace:HandsLiftedApp.Core.Models"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <!-- <viewModels:MainViewModel /> -->
        <mockData1:MockMainWindowViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:ColorToBrush
                A="0.2"
                L="0.4"
                S="0.4"
                x:Key="ColorToLightLuminanceBrush" />
            <converters:ColorToBrush
                L="0.6"
                S="0.7"
                x:Key="ColorToDarkLuminanceBrush" />
            <converters:ColorToConstrastingBrush x:Key="ColorToConstrastingBrush" />
            <converters:ColorToLightLuminance x:Key="ColorToLightLuminance" />
            <converters:ColorToLightLuminance
                L="0.4"
                S="0.8"
                x:Key="ColorToBrightLuminance" />
            <converters:ChainedConverter
                Converter1="{StaticResource ColorToLightLuminance}"
                Converter2="{StaticResource ColorToBrushConverter}"
                x:Key="ChainedConverter" />
            <converters:ChainedConverter
                Converter1="{StaticResource ColorToBrightLuminance}"
                Converter2="{StaticResource ColorToBrushConverter}"
                x:Key="ChainedBrightConverter" />
            <converters:StringToUppercaseConverter x:Key="StringToUppercaseConverter" />
            <converters:ItemToIndexConverter x:Key="itemToIndexConverter" />
            <converters:IntMinusOneConverter x:Key="intMinusOneConverter" />
            <avaloniaconverters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
            <converters:IsGreaterThanConverter x:Key="IsGreaterThanConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://HandsLiftedApp.Core/Assets/AddItemFlyoutResourceDictionary.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="GroupHeadingBackground">#eeecf5</SolidColorBrush>
                    <SolidColorBrush x:Key="GroupHeadingForeground">#383838</SolidColorBrush>
                    <SolidColorBrush x:Key="GroupHeadingBorderBrush">#b0aebf</SolidColorBrush>
                    <SolidColorBrush x:Key="ActiveItemForeground">#4d347f</SolidColorBrush>
                    <SolidColorBrush x:Key="InactiveItemForeground">Black</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="GroupHeadingBackground">#78494949</SolidColorBrush>
                    <SolidColorBrush x:Key="GroupHeadingForeground">#DBDBDB</SolidColorBrush>
                    <SolidColorBrush x:Key="GroupHeadingBorderBrush">#5c5c5c</SolidColorBrush>
                    <SolidColorBrush x:Key="ActiveItemForeground">White</SolidColorBrush>
                    <SolidColorBrush x:Key="InactiveItemForeground">#a2a2a2</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem
                            Click="AddItem_OnClick"
                            CommandParameter="{Binding}"
                            Header="Add Item">
                            <MenuItem.Icon>
                                <material:MaterialIcon Kind="Plus" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu AttachedToLogicalTree="StyledElement_OnAttachedToLogicalTree" Closed="MenuBase_OnClosed">
                        <MenuItem
                            Click="MoveUpItem_OnClick"
                            CommandParameter="{Binding}"
                            Header="Move Up">
                            <MenuItem.Icon>
                                <material:MaterialIcon Kind="ArrowUp" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Click="MoveDownItem_OnClick"
                            CommandParameter="{Binding}"
                            Header="Move Down">
                            <MenuItem.Icon>
                                <material:MaterialIcon Kind="ArrowDown" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Click="DuplicateItem_OnClick"
                            CommandParameter="{Binding}"
                            Header="Duplicate Item">
                            <MenuItem.Icon>
                                <material:MaterialIcon Kind="ContentDuplicate" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Click="DeleteItem_OnClick"
                            CommandParameter="{Binding}"
                            Header="Remove Item">
                            <MenuItem.Icon>
                                <material:MaterialIcon Kind="Times" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Click="AddItem_OnClick"
                            CommandParameter="{Binding}"
                            Header="Add Item">
                            <MenuItem.Icon>
                                <material:MaterialIcon Kind="Plus" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="CornerRadius" Value="0 0 0 0" />
            <!--<Setter Property="(i:Interaction.Behaviors)">
                <i:BehaviorCollectionTemplate>
                    <i:BehaviorCollection>
                        <behaviours:DragControlBehavior />
                    </i:BehaviorCollection>
                </i:BehaviorCollectionTemplate>
            </Setter>-->
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ActiveItemForeground}" />
            <!--<Setter Property="BorderBrush" Value="#6259A5" />-->
        </Style>

        <Style Selector="TextBlock.ItemTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InactiveItemForeground}" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.ItemTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ActiveItemForeground}" />
        </Style>

        <Style Selector="TextBlock.isSelectedItem">
            <Setter Property="Foreground" Value="#FF3400" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="ListBoxItem TextBlock.SectionHeadingTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GroupHeadingForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="ListBoxItem:selected TextBlock.SectionHeadingTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ActiveItemForeground}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="ListBoxItem material|MaterialIcon">
            <Setter Property="Foreground" Value="#888888" />
        </Style>
        <Style Selector="ListBoxItem items1|ItemIcon">
            <Setter Property="Foreground" Value="#888888" />
        </Style>
        <Style Selector="ListBoxItem:selected material|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource ActiveItemForeground}" />
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C11F576F" />
            <!--<Setter Property="BorderBrush" Value="#1f576f" />-->
        </Style>

        <Style Selector="ListBoxItem Border.SectionHeadingBorder" x:DataType="items:SectionHeadingItem">
            <Setter Property="BorderBrush" Value="{Binding ItemGroupAvaloniaColor, Converter={StaticResource ColorToDarkLuminanceBrush}, FallbackValue='#9a93cd'}" />
            <Setter Property="Background" Value="{DynamicResource GroupHeadingBackground}" />
        </Style>

        <Style Selector="ListBoxItem Border.SectionHeadingBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource GroupHeadingBorderBrush}" />
        </Style>

        <Style Selector="ListBoxItem:selected Border.SectionHeadingBorder">
            <!-- <Setter Property="Background" Value="#494949" /> -->
        </Style>
        <!--<Style Selector="ListBoxItem:pointerover Border.SectionHeadingBorder">
            <Setter Property="Background" Value="#C11F576F" />
        </Style>-->

        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <!--<Setter Property="BorderBrush" Value="#6259A5" />-->
        </Style>

        <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
            <!--<Setter Property="Background" Value="#6259A5"/>-->
        </Style>

        <Style Selector="ListBoxItem.menu-open /template/ ContentPresenter">
            <Setter Property="Background" Value="#C11F576F" />
            <!--<Setter Property="BorderBrush" Value="#1f576f" />-->
        </Style>

    </UserControl.Styles>

    <Grid x:Name="Root">
        <ScrollViewer>
            <!--  SelectedIndex="{Binding SelectedItemIndex}"  -->
            <ListBox
                Background="{DynamicResource SurfaceBrush}"
                Classes="ItemsDragAndDrop"
                ClipToBounds="True"
                CornerRadius="0,6,0,6"
                DragDrop.AllowDrop="True"
                ItemsSource="{Binding Items, Mode=OneWay}"
                Margin="0,0,0,60"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                x:Name="itemsListBox">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!--  disable virtualization  -->
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <!--
                    TODO how to register custom 'classes' on the list *item* object?
                -->
                <!-- <ListBox.ContextMenu> -->
                <!--     <ContextMenu> -->
                <!--         <MenuItem Header="Add Item" /> -->
                <!--     </ContextMenu> -->
                <!-- </ListBox.ContextMenu> -->
                <ListBox.ItemTemplate>
                    <common:MyTemplateSelector>
                        <DataTemplate x:DataType="items:SectionHeadingItem" x:Key="SectionHeadingItem">
                            <!--  TODO not working  -->
                            <!--<Grid.Styles>
									<Style Selector="Border:pointerover">
										<Setter Property="Background" Value="#214c5e" />
									</Style>
								</Grid.Styles>-->
                            <Border BorderThickness="0,1,0,1" Classes="SectionHeadingBorder">
                                <DockPanel Margin="9,0,0,0" VerticalAlignment="Stretch">
                                    <Grid>
                                        <TextBlock
                                            Classes="SectionHeadingTextBlock"
                                            FontSize="12"
                                            IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                            Padding="8,4,0,4"
                                            Text="(New section)"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Classes="SectionHeadingTextBlock"
                                            FontSize="12"
                                            Padding="8,4,0,4"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DockPanel>
                                <i:Interaction.Behaviors>
                                    <behaviours:DragControlBehavior />
                                </i:Interaction.Behaviors>
                            </Border>
                        </DataTemplate>
                        <DataTemplate x:DataType="items:CommentItem" x:Key="CommentItem">
                            <DockPanel
                                Background="Transparent"
                                Margin="0,0,0,0"
                                VerticalAlignment="Stretch">
                                <items1:ItemIcon DockPanel.Dock="Left" Margin="12,0,8,0" />
                                <TextBlock
                                    Classes="ItemTextBlock"
                                    FontSize="12"
                                    Padding="0,8,0,8"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}">
                                            <Binding Path="Title" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <i:Interaction.Behaviors>
                                    <behaviours:DragControlBehavior />
                                </i:Interaction.Behaviors>
                            </DockPanel>
                        </DataTemplate>
                        <DataTemplate x:CompileBindings="False" x:Key="Fallback">
                            <DockPanel
                                Background="Transparent"
                                Margin="0,0,0,0"
                                VerticalAlignment="Stretch">
                                <Grid Width="12">
                                    <Viewbox
                                        Height="22"
                                        IsVisible="{Binding SelectedSlideIndex, FallbackValue=-1, Converter={StaticResource IsGreaterThanConverter}}"
                                        Margin="-8,0,8,0"
                                        Width="22">
                                        <Polygon Fill="#FF3400" Points="0,0 8,5, 0,10" />
                                    </Viewbox>
                                </Grid>
                                <items1:ItemIcon
                                    DockPanel.Dock="Left"
                                    Foreground="#a2a2a2"
                                    Margin="0,0,8,0" />
                                <TextBlock
                                    Classes="ItemTextBlock"
                                    Classes.isSelectedItem="{Binding SelectedSlideIndex, FallbackValue=-1, Converter={StaticResource IsGreaterThanConverter}}"
                                    FontSize="12"
                                    Padding="0,8,0,8"
                                    TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}">
                                            <Binding Path="Title" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock
                                    Classes="ItemTextBlock"
                                    FontSize="12"
                                    IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                    Padding="0,8,0,8"
                                    Text="(New item)"
                                    TextTrimming="CharacterEllipsis" />
                                <i:Interaction.Behaviors>
                                    <behaviours:DragControlBehavior />
                                </i:Interaction.Behaviors>
                            </DockPanel>
                        </DataTemplate>
                    </common:MyTemplateSelector>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
        <Button
            Background="#4d347f"
            BorderThickness="0"
            ClickMode="Press"
            CornerRadius="6"
            Cursor="Hand"
            DataContext="{Binding Items.Count, Converter={StaticResource intMinusOneConverter}}"
            DockPanel.Dock="Bottom"
            Flyout="{StaticResource addItemFlyout}"
            FontSize="14"
            Foreground="White"
            HorizontalAlignment="Right"
            HorizontalContentAlignment="Left"
            Margin="6,0,8,8"
            Name="AddItemButton"
            Padding="12"
            VerticalAlignment="Bottom"
            ZIndex="999">
            <Button.Styles>
                <Style Selector="ScrollViewer">
                    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                </Style>
                <Style Selector="MenuItem">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Padding" Value="8 6" />
                </Style>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#5C3AB6" />
                </Style>
                <Style Selector="Button:pressed /template/ ContentPresenter">
                    <Setter Property="BorderBrush" Value="#2c628b" />
                    <Setter Property="Background" Value="#5F5C2ED6" />
                </Style>
            </Button.Styles>
            <Button.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Color="#55000000"
                    OffsetX="0"
                    OffsetY="1" />
            </Button.Effect>

            <DockPanel>
                <material:MaterialIcon
                    DockPanel.Dock="Left"
                    Height="20"
                    Kind="Plus"
                    Width="20" />
                <TextBlock
                    IsVisible="True"
                    Margin="8,0,8,0"
                    Text="Add Item"
                    VerticalAlignment="Center" />
            </DockPanel>
        </Button>

    </Grid>
</UserControl>