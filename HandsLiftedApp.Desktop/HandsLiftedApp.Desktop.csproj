<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!--If you are willing to use Windows/MacOS native APIs you will need to create 3 projects.
        One for Windows with net8.0-windows TFM, one for MacOS with net8.0-macos and one with net8.0 TFM for Linux.-->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationIcon>app.ico</ApplicationIcon>
        <Company>TwoHandsLifted</Company>
        <Product>VisionScreens Church Presentation Software</Product>
        <PackageIcon>app.ico</PackageIcon>
        <UserSecretsId>b7aca156-4577-4098-b109-b5a2160f5c03</UserSecretsId>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>twohandslifted.snk</AssemblyOriginatorKeyFile>

<!--        &lt;!&ndash; Add these properties &ndash;&gt;-->
<!--        <CFBundleName>YourAppName</CFBundleName>-->
<!--        <ApplicationId>com.yourcompany.yourappname</ApplicationId>-->
<!--        <CFBundleIdentifier>com.yourcompany.yourappname</CFBundleIdentifier>-->
<!--        <CFBundlePackageType>APPL</CFBundlePackageType>-->
<!--        <CFBundleShortVersionString>1.0</CFBundleShortVersionString>-->
<!--        <CFBundleVersion>1</CFBundleVersion>-->

    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
</PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HandsLiftedApp.Controls\HandsLiftedApp.Controls.csproj" />
        <ProjectReference Include="..\HandsLiftedApp.Core\HandsLiftedApp.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="app.ico" />
    </ItemGroup>

    <ItemGroup>
      <None Update="credentials.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <PropertyGroup>
      <_InteropHostSrcDir>$(MSBuildThisFileDirectory)..\HandsLiftedApp.Importer.PowerPointInteropHost\bin\$(Configuration)\net10.0-windows\</_InteropHostSrcDir>
      <_InteropHostSrc>$(_InteropHostSrcDir)HandsLiftedApp.Importer.PowerPointInteropHost.exe</_InteropHostSrc>
      <_InteropHostDestDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\PowerPointInteropHost\</_InteropHostDestDir>
    </PropertyGroup>

    <!--
      The helper exe is a framework-dependent apphost: it needs its companion .dll,
      .deps.json, .runtimeconfig.json, and NetOffice/protobuf-net dependencies sitting
      next to it, or it fails immediately with "The application to execute does not exist".
      Copy the whole build output into a subfolder (not Desktop's own output root) to
      avoid colliding with Desktop's own copies of shared dependencies.
    -->
    <ItemGroup>
      <_InteropHostFiles Include="$(_InteropHostSrcDir)**\*.*" />
    </ItemGroup>

    <Target Name="CopyInteropHost" AfterTargets="Build" Condition="Exists('$(_InteropHostSrc)')">
      <Copy SourceFiles="@(_InteropHostFiles)" DestinationFolder="$(_InteropHostDestDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
      <Message Text="Copied InteropHost (%(_InteropHostFiles.Identity)) to $(_InteropHostDestDir)" Importance="normal" />
    </Target>

    <!--
      Publish the PowerPoint interop host alongside Desktop's own publish output whenever
      Desktop is published for a Windows RID (Rider "Publish to folder" or `dotnet publish`).
      Skipped for non-win RIDs (or framework-dependent publish with no RID) since the helper
      is Windows-only (WinForms/COM interop) and can't be built for those targets at all.
    -->
    <Target Name="PublishInteropHost" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('win'))">
      <MSBuild Projects="$(MSBuildThisFileDirectory)..\HandsLiftedApp.Importer.PowerPointInteropHost\HandsLiftedApp.Importer.PowerPointInteropHost.csproj"
                Targets="Publish"
                Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)PowerPointInteropHost\;PublishSingleFile=false" />
      <Message Text="Published InteropHost to $(PublishDir)PowerPointInteropHost\" Importance="normal" />
    </Target>
</Project>
